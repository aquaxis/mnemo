{
  "name": "mnemo",
  "version": "0.1.0",
  "private": true,
  "description": "Mnemo — an integrated, Markdown-based knowledge database (memory & knowledge archive).",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:rs",
    "build:web": "npm run build --workspace web",
    "build:rs": "cargo build --release --manifest-path server-rs/Cargo.toml",
    "start": "npm run build && ./server-rs/target/release/mnemo-server",
    "dev:web": "npm run dev --workspace web",
    "update": "sh ./install.sh .",
    "test": "cargo test --manifest-path server-rs/Cargo.toml",
    "lint": "cargo clippy --manifest-path server-rs/Cargo.toml -- -D warnings || cargo build --release --manifest-path server-rs/Cargo.toml",
    "format": "cargo fmt --manifest-path server-rs/Cargo.toml"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
