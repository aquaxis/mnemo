{
  "port": 3000,
  "ai": {
    "type": "agent-cli",
    "outputLanguage": "ja",
    "timeoutMs": 600000,
    "maxOutputBytes": 2000000,
    "maxConcurrentRuns": 2,
    "backends": {
      "agent-cli": { "command": "agent-cli", "args": ["one-shot", "--auto-approve-tools"], "model": null },
      "claude-code": { "command": "claude", "args": ["-p"], "model": null }
    }
  },
  "search": {
    "endpoint": "https://s.jina.ai/?q=",
    "apiKey": "$JINA_API_KEY",
    "noContent": true,
    "timeoutMs": 20000,
    "endpoints": []
  }
}
